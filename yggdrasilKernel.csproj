<Project Sdk="Cosmos.Sdk/3.0.89">

    <!-- dotnet settings -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <!-- compile only the src folder .cs files -->
    <ItemGroup>
        <Compile Include="src\**\*.cs" />
    </ItemGroup>

    <!-- Core kernel and System packages -->
    <ItemGroup>
        <PackageReference Include="Cosmos.Kernel" Version="3.0.89" />
        <PackageReference Include="Cosmos.Kernel.System" Version="3.0.89" />
        <Compile Remove="CursorAsset.g.cs" />
    </ItemGroup>


    <!-- Cosmos Settings -->
    <PropertyGroup>
        <CosmosEnableStorage>true</CosmosEnableStorage>
    </PropertyGroup>


    <!-- Extracts the Windows cursor asset for the project -->
    <Target Name="ExtractWindowsCursor" BeforeTargets="CoreCompile" Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(WINDIR)\Cursors\aero_arrow.cur')">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\ExtractCursor.ps1&quot; -InputPath &quot;$(WINDIR)\Cursors\aero_arrow.cur&quot; -OutputPath &quot;$(IntermediateOutputPath)CursorAsset.g.cs&quot;" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)CursorAsset.g.cs" />
        </ItemGroup>
    </Target>

    <Target Name="GenerateStartMenuLogo" BeforeTargets="CoreCompile">
        <Error Condition="'$(OS)' != 'Windows_NT'" Text="The Start menu logo asset must be generated on Windows." />
        <Error Condition="!Exists('$(WINDIR)\System32\@WLOGO_96x96.png')" Text="Could not find $(WINDIR)\System32\@WLOGO_96x96.png. Restore this image from your Windows installation and rebuild." />
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\ExtractStartMenuLogo.ps1&quot; -InputPath &quot;$(WINDIR)\System32\@WLOGO_96x96.png&quot; -OutputPath &quot;$(IntermediateOutputPath)StartMenuLogoAsset.g.cs&quot;" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)StartMenuLogoAsset.g.cs" />
        </ItemGroup>
    </Target>


    <!-- Redirects build output and intermediate files to the 'Build' directory -->
    <PropertyGroup>
        <CosmosOutputDir>Build\output-x64\</CosmosOutputDir>
        <IsoFile>Build\output-x64\$(MSBuildProjectName).iso</IsoFile>

        <!-- Redirects 'bin' to 'Build/bin/' -->
        <BaseOutputPath>Build\bin\</BaseOutputPath>

        <!-- Redirects 'obj' to 'Build/obj/' -->
        <BaseIntermediateOutputPath>Build\obj\</BaseIntermediateOutputPath>
    </PropertyGroup>


</Project>
